{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Budgetly",
  "version": "0.8.0",
  "identifier": "dev.budgetly.app",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Budgetly",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/budgetly-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/lib/*": "lib/"
    },
    "shortDescription": "Budget et patrimoine, en local",
    "category": "Finance"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCM0M3QzdENzkzMDdFQUUKUldTdWZqQjVmWHc4aTMrR1dEZXVwRkhwa2FxV21pMG9zVDdiOWdQT2p3SHo5SDUrcXFPRUdMbE4K",
      "endpoints": [
        "https://github.com/march21/budgetly-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
